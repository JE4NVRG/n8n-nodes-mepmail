{
	"name": "n8n-nodes-mepmail",
	"version": "0.1.0",
	"description": "n8n community nodes for MepMail — send transactional email and manage contacts, domains, broadcasts and suppressions on MepMail cloud or any self-hosted instance (Resend wire-compatible).",
	"license": "MIT",
	"homepage": "https://mepmail.je4ndev.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"mepmail",
		"email",
		"transactional-email",
		"resend",
		"ses",
		"deliverability"
	],
	"author": {
		"name": "je4ndev",
		"email": "jean@je4ndev.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/JE4NVRG/n8n-nodes-mepmail.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MepMailApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/MepMail/MepMail.node.js",
			"dist/nodes/MepMail/MepMailTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
